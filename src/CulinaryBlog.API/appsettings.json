{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": { "Provider": "Minio" },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "UseSsl": false,
    "BucketName": "culinary-blog",
    "PublicBaseUrl": "http://localhost:9000"
  },
  "Jwt": {
    "Secret": "CulinaryBlogDefaultSuperSecretKeyForDevelopmentAndTestingPurposesOnly32Chars!",
    "Issuer": "CulinaryBlog",
    "Audience": "CulinaryBlogApp",
    "ExpiryMinutes": 15
  }
}
